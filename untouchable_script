#!/usr/bin/env bash
# Personal Void Linux installer for rnicro's HP Pavilion x360 setup.
# Run as root from a UEFI-booted Void live ISO.
# Based on the user's previous installer and Void's documented chroot workflow.

set -Eeuo pipefail
export LC_ALL=C

MNT=/mnt
STATE_FILE=/tmp/fj-void-installer.state
LOG_FILE=/tmp/fj-void-installer.log
RNICRO_RAW=https://raw.githubusercontent.com/rnicro/setup/main/HOME
REPO_BASE=https://repo-default.voidlinux.org

PHASE=0
MOUNTED_BY_US=0
TARGET_DISK=
PART_ROOT=
PART_EFI=
PART_SWAP=
LIBC=
ARCH=
REPO=
HOSTNAME=pc
TIMEZONE=Asia/Kolkata
KEYMAP=us
USERNAME=fj
DISPLAY_NAME=
ROOT_MOUNT_OPTS=noatime,commit=60
ROOT_UUID=
FORMAT_EFI=
WIFI_SSID=
WIFI_PASSWORD=

[[ -r /dev/tty && -t 0 ]] || { printf 'Run this installer from an interactive terminal.\n' >&2; exit 1; }
touch "$LOG_FILE"
exec > >(tee -a "$LOG_FILE" >/dev/null) 2>&1

say()  { printf '\n==> %s\n' "$*" | tee -a "$LOG_FILE" >/dev/tty; }
warn() { printf '[WARN] %s\n' "$*" | tee -a "$LOG_FILE" >/dev/tty; }
die()  { printf '[ERROR] %s\n' "$*" | tee -a "$LOG_FILE" >/dev/tty; on_error 1 "${BASH_LINENO[0]:-0}"; }
ask()  { printf '%s' "$1" >/dev/tty; IFS= read -r REPLY </dev/tty; }
ask_secret() { printf '%s' "$1" >/dev/tty; IFS= read -r -s REPLY </dev/tty; printf '\n' >/dev/tty; }
show_cmd() { "$@" 2>&1 | tee -a "$LOG_FILE" >/dev/tty; }

write_state_file() {
    local destination=$1 temporary="${1}.tmp"
    {
        printf 'PHASE=%q\n' "$PHASE"
        printf 'TARGET_DISK=%q\n' "$TARGET_DISK"
        printf 'PART_ROOT=%q\n' "$PART_ROOT"
        printf 'PART_EFI=%q\n' "$PART_EFI"
        printf 'PART_SWAP=%q\n' "$PART_SWAP"
        printf 'LIBC=%q\n' "$LIBC"
        printf 'ARCH=%q\n' "$ARCH"
        printf 'REPO=%q\n' "$REPO"
        printf 'HOSTNAME=%q\n' "$HOSTNAME"
        printf 'TIMEZONE=%q\n' "$TIMEZONE"
        printf 'KEYMAP=%q\n' "$KEYMAP"
        printf 'USERNAME=%q\n' "$USERNAME"
        printf 'DISPLAY_NAME=%q\n' "$DISPLAY_NAME"
        printf 'ROOT_MOUNT_OPTS=%q\n' "$ROOT_MOUNT_OPTS"
        printf 'ROOT_UUID=%q\n' "$ROOT_UUID"
        printf 'FORMAT_EFI=%q\n' "$FORMAT_EFI"
        printf 'WIFI_SSID=%q\n' "$WIFI_SSID"
    } > "$temporary"
    chmod 0600 "$temporary"
    mv -f "$temporary" "$destination"
}

save_state() {
    write_state_file "$STATE_FILE"
    if (( MOUNTED_BY_US )) && mountpoint -q "$MNT"; then
        mkdir -p "$MNT/root"
        install -m 0600 "$STATE_FILE" "$MNT/root/.fj-void-installer.state" || true
        cp -f "$LOG_FILE" "$MNT/root/fj-void-installer.log" || true
    fi
}

cleanup_mounts() {
    set +e
    if (( MOUNTED_BY_US )); then
        if [[ -n "$PART_SWAP" ]] && swapon --show=NAME --noheadings 2>/dev/null | grep -Fxq "$PART_SWAP"; then
            swapoff "$PART_SWAP"
        fi
        if mountpoint -q "$MNT"; then
            umount -R "$MNT"
        fi
        MOUNTED_BY_US=0
    fi
    set -e
}

on_error() {
    local status=$1 line=$2
    trap - ERR
    save_state || true
    warn "Installer stopped at script line $line (exit status $status)."
    cleanup_mounts
    say "Recent log output (full log: $LOG_FILE):"
    tail -n 45 "$LOG_FILE" | tee /dev/tty >/dev/null || true
    exit "$status"
}
trap 'on_error "$?" "$LINENO"' ERR
trap 'cleanup_mounts' EXIT
trap 'on_error 130 "$LINENO"' INT TERM

load_state() {
    [[ -f "$STATE_FILE" ]] || die "No saved state file exists in this live session."
    # This file is generated by this installer and contains no passwords.
    # shellcheck disable=SC1090
    source "$STATE_FILE"
}

resume_from_disk() {
    local resume_root
    ask 'Root partition containing the partial installation (example /dev/sda3): '
    resume_root=$REPLY
    [[ -b "$resume_root" ]] || die "Not a block device: $resume_root"
    mkdir -p "$MNT"
    mount -o ro "$resume_root" "$MNT"
    MOUNTED_BY_US=1
    if [[ ! -f "$MNT/root/.fj-void-installer.state" ]]; then
        cleanup_mounts
        die "No saved installer state was found on $resume_root."
    fi
    cp "$MNT/root/.fj-void-installer.state" "$STATE_FILE"
    if [[ -f "$MNT/root/fj-void-installer.log" && ! -s "$LOG_FILE" ]]; then
        cat "$MNT/root/fj-void-installer.log" >> "$LOG_FILE"
    fi
    cleanup_mounts
    load_state
    [[ "$PART_ROOT" == "$resume_root" ]] || die "The saved state does not match the supplied root partition."
}

reset_install_state() {
    PHASE=0
    TARGET_DISK=
    PART_ROOT=
    PART_EFI=
    PART_SWAP=
    LIBC=
    ARCH=
    REPO=
    HOSTNAME=pc
    TIMEZONE=Asia/Kolkata
    KEYMAP=us
    USERNAME=fj
    DISPLAY_NAME=
    ROOT_MOUNT_OPTS=noatime,commit=60
    ROOT_UUID=
    FORMAT_EFI=
    WIFI_SSID=
    WIFI_PASSWORD=
}

choose_start_mode() {
    local choice
    if [[ -f "$STATE_FILE" ]]; then
        load_state
        if (( PHASE >= 6 )); then
            say "A completed installation state exists (phase $PHASE)."
            printf '1) Start a new installation\n2) Show recent log\n3) Exit\n' >/dev/tty
            ask 'Choice [3]: '
            choice=${REPLY:-3}
            case "$choice" in
                1) rm -f "$STATE_FILE"; reset_install_state ;;
                2) tail -n 80 "$LOG_FILE" | tee /dev/tty >/dev/null; exit 0 ;;
                *) exit 0 ;;
            esac
        else
            say "An unfinished installation was saved at phase $PHASE."
            printf '1) Resume saved installation\n2) Start a new installation\n3) Show recent log\n4) Exit\n' >/dev/tty
            ask 'Choice [1]: '
            choice=${REPLY:-1}
            case "$choice" in
                1) return 0 ;;
                2) rm -f "$STATE_FILE"; reset_install_state ;;
                3) tail -n 80 "$LOG_FILE" | tee /dev/tty >/dev/null; exit 0 ;;
                *) exit 0 ;;
            esac
        fi
    else
        say "Void Linux personal installer — HP Pavilion x360."
        printf '1) New installation\n2) Resume from a partially installed root partition\n3) Show recent live-session log\n4) Exit\n' >/dev/tty
        ask 'Choice [1]: '
        choice=${REPLY:-1}
        case "$choice" in
            1) PHASE=0 ;;
            2) resume_from_disk ;;
            3) [[ ! -f "$LOG_FILE" ]] || tail -n 80 "$LOG_FILE" | tee /dev/tty >/dev/null; exit 0 ;;
            *) exit 0 ;;
        esac
    fi
}

network_available() {
    curl -fsSL --connect-timeout 5 --max-time 15 "$REPO/$ARCH-repodata" -o /dev/null
}

connect_live_wifi() {
    local iface tmpconf
    command -v iw >/dev/null 2>&1 || return 1
    command -v wpa_supplicant >/dev/null 2>&1 || return 1
    command -v wpa_passphrase >/dev/null 2>&1 || return 1
    command -v dhcpcd >/dev/null 2>&1 || return 1
    iface=$(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2; exit }')
    [[ -n "$iface" ]] || return 1

    ask "Wi-Fi SSID for live installation network ($iface): "
    WIFI_SSID=$REPLY
    [[ -n "$WIFI_SSID" ]] || return 1
    [[ ${#WIFI_SSID} -le 32 ]] || { warn 'Wi-Fi SSIDs must be at most 32 bytes.'; return 1; }
    ask_secret "Wi-Fi passphrase: "
    WIFI_PASSWORD=$REPLY
    [[ ${#WIFI_PASSWORD} -ge 8 && ${#WIFI_PASSWORD} -le 63 ]] || {
        warn 'WPA passphrases must be 8–63 characters for this setup.'
        return 1
    }
    tmpconf=$(mktemp)
    chmod 0600 "$tmpconf"
    printf '%s\n' "$WIFI_PASSWORD" | wpa_passphrase "$WIFI_SSID" | sed '/^[[:space:]]*#psk=/d' > "$tmpconf"
    wpa_supplicant -B -i "$iface" -c "$tmpconf"
    dhcpcd "$iface"
    sleep 4
    rm -f "$tmpconf"
}

prepare_live_environment() {
    [[ $EUID -eq 0 ]] || die 'Run this script as root from the Void live ISO.'
    [[ $(uname -m) == x86_64 ]] || die 'This installer is written for x86_64.'
    [[ -d /sys/firmware/efi ]] || die 'Boot the live ISO in UEFI mode; this installer uses systemd-boot.'
    for command_name in curl xbps-install xbps-uhelper lsblk cfdisk mkfs.ext4 mkfs.vfat mkswap swapon swapoff mount umount mountpoint blkid findmnt blockdev awk sed grep sort tar chroot find od udevadm sha256sum tail tee; do
        command -v "$command_name" >/dev/null 2>&1 || die "Required live command not found: $command_name"
    done

    if [[ ! -d /sys/firmware/efi/efivars ]]; then
        die 'UEFI efivars are not available in this live session.'
    fi
    if ! mountpoint -q /sys/firmware/efi/efivars; then
        mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true
    fi
    local sb_file sb_value
    sb_file=$(find /sys/firmware/efi/efivars -maxdepth 1 -name 'SecureBoot-*' -print -quit 2>/dev/null || true)
    if [[ -n "$sb_file" ]]; then
        sb_value=$(od -An -j4 -N1 -tu1 "$sb_file" 2>/dev/null | tr -d ' ' || true)
        [[ "$sb_value" != 1 ]] || die 'Secure Boot is enabled. This installer does not sign the bootloader or custom kernel; disable Secure Boot in firmware before continuing.'
    else
        warn 'Could not read the Secure Boot state.'
        ask 'Confirm that Secure Boot is disabled in UEFI firmware? [y/N]: '
        [[ "$REPLY" =~ ^[Yy]$ ]] || die 'Secure Boot status is unknown or enabled; stopping before disk changes.'
    fi

    [[ -n "$LIBC" && -n "$ARCH" && -n "$REPO" ]] || detect_target_libc

    if ! network_available; then
        warn 'The Void repository is not reachable yet. Trying a simple Wi-Fi connection setup.'
        connect_live_wifi || true
    fi
    network_available || die 'No connection to the selected Void repository. Connect Ethernet or Wi-Fi, then rerun the installer. No partitions have been formatted.'

    if ! command -v jq >/dev/null 2>&1 || ! command -v xchroot >/dev/null 2>&1 || ! command -v xgenfstab >/dev/null 2>&1; then
        say 'Installing jq and xtools in the live environment.'
        xbps-install -Sy -y jq xtools
    fi
    for command_name in jq xchroot xgenfstab xbps-uhelper xbps-rindex udevadm getent useradd usermod chpasswd; do
        command -v "$command_name" >/dev/null 2>&1 || die "Required command not found after live setup: $command_name"
    done
}

detect_target_libc() {
    local ldd_output native_arch
    ldd_output=$(ldd --version 2>&1 || true)
    native_arch=$(xbps-uhelper arch)
    if grep -qi musl <<<"$ldd_output" || [[ "$native_arch" == *-musl ]]; then
        LIBC=musl
        ARCH=x86_64-musl
        REPO="$REPO_BASE/current/musl"
    elif grep -qiE 'GNU libc|GLIBC|GNU C Library' <<<"$ldd_output" || [[ "$native_arch" == x86_64 ]]; then
        LIBC=glibc
        ARCH=x86_64
        REPO="$REPO_BASE/current"
    else
        die "Could not detect the live ISO libc (ldd output: $ldd_output)."
    fi
}

check_disk_idle() {
    local disk=$1 swap_name parent
    if lsblk -nrpo NAME,MOUNTPOINT "$disk" | awk 'NF > 1 && $2 != "" { found=1 } END { exit !found }'; then
        die "Some partition on $disk is mounted. Unmount it before installation."
    fi
    while read -r swap_name; do
        [[ -n "$swap_name" ]] || continue
        parent=$(lsblk -dnro PKNAME "$swap_name" 2>/dev/null || true)
        if [[ "$swap_name" == "$disk" || "$parent" == "$(basename "$disk")" ]]; then
            die "A swap partition on $disk is active ($swap_name). Disable it before installation."
        fi
    done < <(swapon --show=NAME --noheadings 2>/dev/null || true)
}

validate_partition() {
    local partition=$1 expected_disk=$2 type parent
    [[ -b "$partition" ]] || die "Not a block device: $partition"
    type=$(lsblk -dnro TYPE "$partition")
    [[ "$type" == part ]] || die "$partition is not a partition."
    parent=$(lsblk -dnro PKNAME "$partition")
    [[ "$parent" == "$(basename "$expected_disk")" ]] || die "$partition is not a partition of $expected_disk."
    [[ -z "$(lsblk -dnro MOUNTPOINT "$partition")" ]] || die "$partition is mounted."
}

choose_partitions() {
    local default_disk method esp_type esp_parttype
    say 'Available disks:'
    lsblk -e 7 -dpno NAME,SIZE,MODEL | tee /dev/tty >/dev/null
    default_disk=/dev/sda
    [[ -b "$default_disk" ]] || default_disk=$(lsblk -e 7 -dpno NAME | head -n1)
    ask "Target disk [${default_disk}]: "
    TARGET_DISK=${REPLY:-$default_disk}
    [[ -b "$TARGET_DISK" ]] || die "Target disk not found: $TARGET_DISK"
    [[ $(lsblk -dnro TYPE "$TARGET_DISK") == disk ]] || die "$TARGET_DISK is not a whole disk."
    check_disk_idle "$TARGET_DISK"

    printf '\nPartitioning method:\n1) Open cfdisk and create/edit partitions\n2) Use partitions that already exist\n' >/dev/tty
    ask 'Choice [1]: '
    method=${REPLY:-1}
    case "$method" in
        1)
            warn "cfdisk will edit the partition table on $TARGET_DISK. Do not write changes you do not intend to make."
            ask "Type PARTITION to open cfdisk on $TARGET_DISK: "
            [[ "$REPLY" == PARTITION ]] || die 'Partitioning cancelled.'
            cfdisk "$TARGET_DISK" </dev/tty >/dev/tty 2>&1
            udevadm settle || sleep 2
            ;;
        2) ;;
        *) die 'Invalid partitioning choice.' ;;
    esac

    say "Partitions on $TARGET_DISK:"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,PARTTYPE,MOUNTPOINT "$TARGET_DISK" | tee /dev/tty >/dev/null
    ask 'Root partition for / (will be formatted ext4): '
    PART_ROOT=$REPLY
    ask 'EFI System Partition for /boot (FAT32): '
    PART_EFI=$REPLY
    ask 'Swap partition (leave blank for no swap): '
    PART_SWAP=$REPLY

    validate_partition "$PART_ROOT" "$TARGET_DISK"
    validate_partition "$PART_EFI" "$TARGET_DISK"
    [[ "$PART_ROOT" != "$PART_EFI" ]] || die 'Root and EFI partitions must be different.'
    if [[ -n "$PART_SWAP" ]]; then
        validate_partition "$PART_SWAP" "$TARGET_DISK"
        [[ "$PART_SWAP" != "$PART_ROOT" && "$PART_SWAP" != "$PART_EFI" ]] || die 'Swap must be a separate partition.'
    fi

    esp_type=$(blkid -o value -s TYPE "$PART_EFI" 2>/dev/null || true)
    esp_parttype=$(lsblk -dnro PARTTYPE "$PART_EFI" | tr '[:upper:]' '[:lower:]')
    [[ "$esp_parttype" == c12a7328-f81f-11d2-ba4b-00a0c93ec93b ]] || \
        die 'The selected EFI partition is not marked as an EFI System Partition. Set its type to EFI System in cfdisk and retry.'
    FORMAT_EFI=no
    if [[ "$esp_type" != vfat ]]; then
        ask 'Selected EFI partition is not FAT. Format it as FAT32? [y/N]: '
        [[ "$REPLY" =~ ^[Yy]$ ]] || die 'EFI partition must be FAT32.'
        FORMAT_EFI=yes
    else
        ask 'EFI partition is already FAT. Reformat it? This removes its current EFI files. [y/N]: '
        [[ "$REPLY" =~ ^[Yy]$ ]] && FORMAT_EFI=yes
    fi

    say 'Installation plan:'
    printf '  Disk:       %s\n  Root:       %s -> ext4 mounted at /\n  EFI:        %s -> FAT32 mounted at /boot (%s)\n  Swap:       %s\n  Libc:       %s (%s)\n  Hostname:   %s\n  User:       %s\n  Root opts:  %s\n' \
        "$TARGET_DISK" "$PART_ROOT" "$PART_EFI" "$FORMAT_EFI" "${PART_SWAP:-none}" "$LIBC" "$ARCH" "$HOSTNAME" "$USERNAME" "$ROOT_MOUNT_OPTS" | tee /dev/tty >/dev/null
    warn 'The selected root will be formatted; selected swap will be initialized. EFI will also be formatted if marked yes. No whole-disk wipe is performed.'
    [[ "$FORMAT_EFI" != yes ]] || warn 'The selected EFI partition will also be formatted, removing its existing EFI files.'
    ask "Type INSTALL $PART_ROOT to format the selected partitions and continue: "
    [[ "$REPLY" == "INSTALL $PART_ROOT" ]] || die 'Installation cancelled before formatting.'
    PHASE=1
    save_state
}

mount_target() {
    mkdir -p "$MNT"
    if mountpoint -q "$MNT"; then
        die "$MNT is already mounted; unmount it before continuing."
    fi
    mount "$PART_ROOT" "$MNT"
    MOUNTED_BY_US=1
    mkdir -p "$MNT/boot"
    mount "$PART_EFI" "$MNT/boot"
    if [[ -n "$PART_SWAP" ]]; then
        swapon "$PART_SWAP" 2>/dev/null || {
            if ! swapon --show=NAME --noheadings | grep -Fxq "$PART_SWAP"; then
                die "Could not enable swap partition $PART_SWAP."
            fi
        }
    fi
}

ensure_fstab_and_root_uuid() {
    mkdir -p "$MNT/etc"
    ROOT_UUID=$(blkid -o value -s UUID "$PART_ROOT")
    [[ -n "$ROOT_UUID" ]] || die 'Could not read the root filesystem UUID.'
    xgenfstab -U "$MNT" > "$MNT/etc/fstab.tmp"
    awk -v opts="$ROOT_MOUNT_OPTS" 'BEGIN { OFS="\t" } /^[[:space:]]*#/ || NF < 4 { print; next } $2 == "/" { $4=opts } { print }' \
        "$MNT/etc/fstab.tmp" > "$MNT/etc/fstab"
    rm -f "$MNT/etc/fstab.tmp"
}

format_and_mount() {
    say "Formatting the selected root partition ($PART_ROOT) as ext4."
    mkfs.ext4 -F -L VOID_ROOT "$PART_ROOT"
    if [[ "$FORMAT_EFI" == yes ]]; then
        say "Formatting the selected EFI partition ($PART_EFI) as FAT32."
        mkfs.vfat -F 32 -n EFI "$PART_EFI"
    fi
    if [[ -n "$PART_SWAP" ]]; then
        say "Initializing swap partition ($PART_SWAP)."
        mkswap -L SWAP "$PART_SWAP"
    fi
    mount_target
    PHASE=2
    ensure_fstab_and_root_uuid
    save_state
    say 'Filesystems mounted and /etc/fstab generated.'
}

write_target_vars() {
    local vars="$MNT/root/.fj-installer-vars"
    {
        printf 'LIBC=%q\n' "$LIBC"
        printf 'ARCH=%q\n' "$ARCH"
        printf 'HOSTNAME=%q\n' "$HOSTNAME"
        printf 'TIMEZONE=%q\n' "$TIMEZONE"
        printf 'KEYMAP=%q\n' "$KEYMAP"
        printf 'USERNAME=%q\n' "$USERNAME"
        printf 'DISPLAY_NAME=%q\n' "$DISPLAY_NAME"
        printf 'ROOT_UUID=%q\n' "$ROOT_UUID"
        printf 'ROOT_MOUNT_OPTS=%q\n' "$ROOT_MOUNT_OPTS"
    } > "$vars"
    chmod 0600 "$vars"
}

bootstrap_base_system() {
    say "Installing Void base system for $ARCH."
    mkdir -p "$MNT/var/db/xbps/keys" "$MNT/etc/xbps.d"
    [[ -d /var/db/xbps/keys ]] || die 'Live environment XBPS keys directory is missing.'
    cp -a /var/db/xbps/keys/. "$MNT/var/db/xbps/keys/"
    cp -L /etc/resolv.conf "$MNT/etc/resolv.conf"

    # Keep Intel GPU firmware and network firmware (required by the Intel 3165 Wi-Fi card).
    # Exclude firmware packages for hardware this laptop does not contain.
    cat > "$MNT/etc/xbps.d/10-ignore-firmware.conf" <<'CONF'
ignorepkg=linux-firmware-amd
ignorepkg=linux-firmware-nvidia
ignorepkg=linux-firmware-broadcom
ignorepkg=linux-firmware-qualcomm
ignorepkg=sof-firmware
ignorepkg=wifi-firmware
CONF

    XBPS_ARCH="$ARCH" xbps-install -y -S -r "$MNT" -R "$REPO" base-system systemd-boot xtools
    PHASE=3
    save_state
}

ensure_saved_wifi_password() {
    if [[ -n "$WIFI_SSID" && -z "$WIFI_PASSWORD" ]]; then
        ask_secret "Re-enter the Wi-Fi passphrase for $WIFI_SSID (not stored in the resume file): "
        WIFI_PASSWORD=$REPLY
        [[ ${#WIFI_PASSWORD} -ge 8 && ${#WIFI_PASSWORD} -le 63 ]] || die 'Wi-Fi passphrase must be 8–63 characters.'
    fi
}

configure_target_system() {
    local target_script="$MNT/root/fj-target-configure.sh"
    write_target_vars
    cat > "$target_script" <<'TARGET'
#!/usr/bin/env bash
set -Eeuo pipefail
source /root/.fj-installer-vars

[[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] || { echo "Timezone not found: $TIMEZONE" >&2; exit 1; }
ln -snf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime

if grep -qE '^[#[:space:]]*HARDWARECLOCK=' /etc/rc.conf; then
    sed -i -E 's|^[#[:space:]]*HARDWARECLOCK=.*|HARDWARECLOCK="UTC"|' /etc/rc.conf
else
    printf '\nHARDWARECLOCK="UTC"\n' >> /etc/rc.conf
fi
if grep -qE '^[#[:space:]]*KEYMAP=' /etc/rc.conf; then
    sed -i -E "s|^[#[:space:]]*KEYMAP=.*|KEYMAP=\"$KEYMAP\"|" /etc/rc.conf
else
    printf 'KEYMAP="%s"\n' "$KEYMAP" >> /etc/rc.conf
fi

printf '%s\n' "$HOSTNAME" > /etc/hostname
cat > /etc/hosts <<EOF_HOSTS
127.0.0.1 localhost
::1 localhost
127.0.1.1 ${HOSTNAME}.localdomain ${HOSTNAME}
EOF_HOSTS

if [[ "$LIBC" == glibc ]]; then
    if [[ -f /etc/default/libc-locales ]]; then
        sed -i -E 's/^#[[:space:]]*(en_US.UTF-8 UTF-8)/\1/' /etc/default/libc-locales
    fi
    printf 'LANG=en_US.UTF-8\n' > /etc/locale.conf
fi

xbps-install -Sy -y void-repo-nonfree
xbps-install -Sy -y \
    foot tofi pipewire wireplumber brightnessctl vim zathura-pdf-mupdf yazi wlsunset \
    elogind grim aria2 mesa-dri mesa-vulkan-intel vulkan-loader intel-media-driver \
    tlp wlroots0.20-devel make pkg-config gcc noto-fonts-ttf intel-ucode curl
if [[ "$LIBC" == glibc ]]; then
    xbps-install -Sy -y binutils xz
fi

if [[ "$LIBC" == glibc ]]; then
    xbps-reconfigure -f glibc-locales
fi

# A compact, purposeful group set. Avoid broad device-access groups such as input, disk or kmem.
user_groups=()
for group in wheel audio video storage; do
    getent group "$group" >/dev/null 2>&1 && user_groups+=("$group")
done
group_csv=$(IFS=,; printf '%s' "${user_groups[*]}")
if id "$USERNAME" >/dev/null 2>&1; then
    [[ -z "$group_csv" ]] || usermod -aG "$group_csv" "$USERNAME"
else
    args=(-m -g users -s /bin/bash)
    [[ -z "$group_csv" ]] || args+=(-G "$group_csv")
    [[ -z "$DISPLAY_NAME" ]] || args+=(-c "$DISPLAY_NAME")
    useradd "${args[@]}" "$USERNAME"
fi

# Void base-system supplies sudo, but wheel is not necessarily enabled in sudoers.
if ! grep -qE '^%wheel[[:space:]]+ALL=' /etc/sudoers; then
    printf '\n%%wheel ALL=(ALL:ALL) ALL\n' >> /etc/sudoers
fi
visudo -c >/dev/null

mkdir -p /etc/runit/runsvdir/default
for service in dhcpcd wpa_supplicant tlp dbus elogind; do
    [[ -d "/etc/sv/$service" ]] || { echo "Missing service directory: $service" >&2; exit 1; }
    ln -sfn "/etc/sv/$service" "/etc/runit/runsvdir/default/$service"
done
rm -f /etc/runit/runsvdir/default/agetty-tty3 \
      /etc/runit/runsvdir/default/agetty-tty4 \
      /etc/runit/runsvdir/default/agetty-tty5 \
      /etc/runit/runsvdir/default/agetty-tty6

# The Void systemd-boot hook uses /boot for the ESP and creates entries on kernel reconfigure.
cat > /etc/default/systemd-boot <<EOF_BOOT
BOOT="/boot"
ESP="/boot"
CMDLINE="root=UUID=${ROOT_UUID} rootfstype=ext4 rw quiet loglevel=3"
EOF_BOOT
mkdir -p /boot/loader/entries
bootctl --esp-path=/boot install
xbps-reconfigure -fa

entries=(/boot/loader/entries/void-*.conf)
if (( ${#entries[@]} == 0 )) || [[ ! -f "${entries[0]}" ]]; then
    latest_kernel=$(find /boot -maxdepth 1 -type f \
        \( -name 'vmlinuz-*' -o -name 'vmlinux-*' \) -printf '%f\n' | sort -V | tail -n 1)
    [[ -n "$latest_kernel" ]] || { echo 'No installed kernel image found in /boot.' >&2; exit 1; }
    kernel_version=${latest_kernel#vmlinuz-}
    kernel_version=${kernel_version#vmlinux-}
    [[ -f "/boot/initramfs-${kernel_version}.img" ]] || { echo 'No matching initramfs found.' >&2; exit 1; }
    cat > "/boot/loader/entries/void-manual-${ARCH}.conf" <<EOF_ENTRY
title Void Linux
linux /${latest_kernel}
initrd /initramfs-${kernel_version}.img
options root=UUID=${ROOT_UUID} rootfstype=ext4 rw quiet loglevel=3
EOF_ENTRY
fi

entry_file=$(find /boot/loader/entries -maxdepth 1 -type f -name "void-${ARCH}-*.conf" -printf '%f\n' | sort -V | tail -n 1)
if [[ -n "$entry_file" ]]; then
    default_entry=$entry_file
else
    entry_file=$(find /boot/loader/entries -maxdepth 1 -type f -name 'void-*.conf' -printf '%f\n' | sort -V | tail -n 1)
    [[ -n "$entry_file" ]] || { echo 'No systemd-boot entries were generated.' >&2; exit 1; }
    default_entry=$entry_file
fi
cat > /boot/loader/loader.conf <<EOF_LOADER
default ${default_entry}
timeout 3
console-mode max
editor no
EOF_LOADER
TARGET
    chmod 0700 "$target_script"
    say 'Configuring packages, account, runit services and systemd-boot.'
    xchroot "$MNT" /root/fj-target-configure.sh

    say 'Writing the wpa_supplicant configuration.'
    mkdir -p "$MNT/etc/wpa_supplicant"
    {
        printf 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=wheel\n'
        printf 'update_config=1\n\n'
        if [[ -n "$WIFI_SSID" ]]; then
            printf '%s\n' "$WIFI_PASSWORD" | xchroot "$MNT" wpa_passphrase "$WIFI_SSID" | sed '/^[[:space:]]*#psk=/d'
        fi
    } > "$MNT/etc/wpa_supplicant/wpa_supplicant.conf"
    chmod 0600 "$MNT/etc/wpa_supplicant/wpa_supplicant.conf"

    set_passwords
    rm -f "$target_script" "$MNT/root/.fj-installer-vars"
    PHASE=4
    save_state
}

set_passwords() {
    local root1 root2 user1 user2
    while true; do
        ask_secret 'New root password: '
        root1=$REPLY
        ask_secret 'Confirm root password: '
        root2=$REPLY
        [[ -n "$root1" && "$root1" == "$root2" ]] && break
        warn 'Root passwords were empty or did not match.'
    done
    while true; do
        ask_secret "New password for $USERNAME: "
        user1=$REPLY
        ask_secret "Confirm password for $USERNAME: "
        user2=$REPLY
        [[ -n "$user1" && "$user1" == "$user2" ]] && break
        warn 'User passwords were empty or did not match.'
    done
    printf 'root:%s\n%s:%s\n' "$root1" "$USERNAME" "$user1" | chroot "$MNT" chpasswd
    unset root1 root2 user1 user2
}

fetch_latest_assets() {
    local repository=$1 json url filename digest path record expected
    local -a asset_records=()
    json=$(curl -fsSL --retry 3 --connect-timeout 10 "https://api.github.com/repos/${repository}/releases/latest") || {
        warn "Could not read the latest release for ${repository}; continuing."
        return 0
    }
    mapfile -t asset_records < <(jq -r '.assets[]? | select(.name | endswith(".x86_64-musl.xbps")) | [.browser_download_url, (.digest // "")] | @tsv' <<<"$json")
    if (( ${#asset_records[@]} == 0 )); then
        warn "No x86_64-musl .xbps assets found for ${repository}."
        return 0
    fi
    for record in "${asset_records[@]}"; do
        IFS=$'\t' read -r url digest <<<"$record"
        filename=${url##*/}
        path="$CUSTOM_PKG_DIR/$filename"
        say "Downloading latest ${repository}: ${filename}"
        if ! curl -fL --retry 3 --connect-timeout 10 "$url" -o "$path"; then
            rm -f "$path"
            warn "Could not download $filename; continuing with the remaining packages."
            continue
        fi
        if [[ "$digest" =~ ^sha256:([[:xdigit:]]{64})$ ]]; then
            expected=${BASH_REMATCH[1]}
            if ! printf '%s  %s\n' "$expected" "$path" | sha256sum -c - >/dev/null; then
                rm -f "$path"
                warn "SHA-256 verification failed for $filename; it will not be installed."
            fi
        else
            warn "GitHub did not publish a SHA-256 digest for $filename; skipping digest verification."
        fi
    done
}

install_custom_musl_packages() {
    local file target_file pkgver
    local files=()
    mapfile -t files < <(find "$CUSTOM_PKG_DIR" -maxdepth 1 -type f -name '*.xbps' -print | sort)
    if (( ${#files[@]} == 0 )); then
        warn 'No custom XBPS packages were downloaded; the standard Void kernel remains installed.'
        return 0
    fi
    say 'Indexing the downloaded XBPS files as a local repository.'
    local target_paths=()
    for file in "${files[@]}"; do
        target_paths+=("/home/$USERNAME/Downloads/xbps/${file##*/}")
    done
    if ! xchroot "$MNT" xbps-rindex -a "${target_paths[@]}"; then
        warn 'xbps-rindex could not index the downloaded files; they will remain in Downloads.'
        return 0
    fi
    for target_file in "${target_paths[@]}"; do
        pkgver=$(xchroot "$MNT" xbps-uhelper binpkgver "${target_file##*/}" 2>/dev/null || true)
        if [[ -z "$pkgver" ]]; then
            warn "Could not read XBPS package metadata for ${target_file##*/}."
            continue
        fi
        say "Installing ${pkgver} from the local package directory."
        if ! xchroot "$MNT" xbps-install -y -R "/home/$USERNAME/Downloads/xbps" "$pkgver"; then
            warn "Could not install ${pkgver}; the downloaded package is being kept."
        fi
    done
}

install_helium_glibc() {
    local json deb_url deb_name deb_digest record expected deb_path
    local -a deb_records=()
    json=$(curl -fsSL --retry 3 --connect-timeout 10 https://api.github.com/repos/imputnet/helium-linux/releases/latest) || {
        warn 'Could not query the latest Helium release.'
        return 0
    }
    mapfile -t deb_records < <(jq -r '.assets[]? | select(.name | endswith("_amd64.deb")) | [.browser_download_url, (.digest // "")] | @tsv' <<<"$json")
    if (( ${#deb_records[@]} == 0 )); then
        warn 'No current amd64 Helium .deb asset was found; skipping Helium installation.'
        return 0
    fi
    record=${deb_records[0]}
    IFS=$'\t' read -r deb_url deb_digest <<<"$record"
    deb_name=${deb_url##*/}
    deb_path="$USER_DOWNLOADS/$deb_name"
    say "Downloading latest Helium package: $deb_name"
    if ! curl -fL --retry 3 --connect-timeout 10 "$deb_url" -o "$deb_path"; then
        rm -f "$deb_path"
        warn 'Could not download Helium; continuing without it.'
        return 0
    fi
    if [[ "$deb_digest" =~ ^sha256:([[:xdigit:]]{64})$ ]]; then
        expected=${BASH_REMATCH[1]}
        if ! printf '%s  %s\n' "$expected" "$deb_path" | sha256sum -c - >/dev/null; then
            rm -f "$deb_path"
            warn 'Helium package SHA-256 verification failed; it will not be installed.'
            return 0
        fi
    else
        warn 'GitHub did not publish a SHA-256 digest for Helium; skipping digest verification.'
    fi
    mkdir -p "$USER_DOWNLOADS/xdeb"
    if ! curl -fL --retry 3 --connect-timeout 10 \
        https://raw.githubusercontent.com/xdeb-org/xdeb/master/xdeb \
        -o "$USER_DOWNLOADS/xdeb/xdeb"; then
        warn 'Could not download xdeb; the Helium .deb remains in Downloads.'
        return 0
    fi
    chmod 0755 "$USER_DOWNLOADS/xdeb/xdeb"
    say 'Converting and installing Helium with xdeb (automatic dependency lookup).'
    if ! xchroot "$MNT" /bin/sh -c "cd /tmp && XDEB_PKGROOT=/tmp/fj-xdeb /home/$USERNAME/Downloads/xdeb/xdeb -Sd -I /home/$USERNAME/Downloads/$deb_name"; then
        warn 'Helium conversion or installation failed. The downloaded .deb and xdeb script remain in Downloads.'
    fi
}

install_personal_files() {
    local home="$MNT/home/$USERNAME"
    USER_DOWNLOADS="$home/Downloads"
    CUSTOM_PKG_DIR="$USER_DOWNLOADS/xbps"
    mkdir -p "$home/.config/tofi" "$home/.config/foot" "$home/.config/velotype" \
        "$home/Downloads" "$home/Notes" "$home/Pictures" "$CUSTOM_PKG_DIR"
    chown -R "$USERNAME:users" "$home"

    say 'Downloading the personal configuration files from rnicro/setup.'
    curl -fL --retry 3 "$RNICRO_RAW/.bash_profile" -o "$home/.bash_profile"
    curl -fL --retry 3 "$RNICRO_RAW/.bashrc" -o "$home/.bashrc"
    curl -fL --retry 3 "$RNICRO_RAW/.config/foot/foot.ini" -o "$home/.config/foot/foot.ini"
    curl -fL --retry 3 "$RNICRO_RAW/.config/tofi/config" -o "$home/.config/tofi/config"
    curl -fL --retry 3 "$RNICRO_RAW/.config/tofi/tofi-status.sh" -o "$home/.config/tofi/tofi-status.sh"
    curl -fL --retry 3 "$RNICRO_RAW/.config/velotype/config.toml" -o "$home/.config/velotype/config.toml"
    curl -fL --retry 3 "$RNICRO_RAW/start-dwl.sh" -o "$home/start-dwl.sh"
    curl -fL --retry 3 "$RNICRO_RAW/bookmarks.html.gpg" -o "$home/bookmarks.html.gpg"
    curl -fL --retry 3 "$RNICRO_RAW/todo" -o "$home/todo"
    curl -fL --retry 3 "$RNICRO_RAW/dwl.tar" -o "$home/dwl.tar"
    chmod 0755 "$home/.config/tofi/tofi-status.sh" "$home/start-dwl.sh"

    say 'Extracting and building dwl as the normal user.'
    rm -rf "$home/dwl"
    tar -xf "$home/dwl.tar" -C "$home"
    rm -f "$home/dwl.tar"
    chown -R "$USERNAME:users" "$home/dwl"
    xchroot "$MNT" su - "$USERNAME" -c 'cd "$HOME/dwl" && make clean && rm -f config.h && make'
    xchroot "$MNT" make -C "/home/$USERNAME/dwl" install
    xchroot "$MNT" su - "$USERNAME" -c 'cd "$HOME/dwl" && make clean && rm -f config.h'

    if [[ "$LIBC" == musl ]]; then
        say 'Looking up the latest x86_64-musl custom packages.'
        fetch_latest_assets rnicro/linux
        fetch_latest_assets rnicro/velotype
        fetch_latest_assets rnicro/Monorepo
        fetch_latest_assets rnicro/brightnessctl
        fetch_latest_assets rnicro/tofi
        fetch_latest_assets rnicro/aria2
        install_custom_musl_packages
        say 'Reconfiguring kernels and refreshing systemd-boot entries.'
        xchroot "$MNT" xbps-reconfigure -fa
    else
        say 'The custom XBPS releases are musl-only; keeping the standard Void kernel on glibc.'
        install_helium_glibc
    fi

    chown -R "$USERNAME:users" "$home"
    PHASE=5
    save_state
}

ask_personal_choices() {
    local input
    [[ -n "$LIBC" ]] || detect_target_libc
    say "Detected $LIBC ($ARCH) from the live environment."
    ask "Hostname [$HOSTNAME]: "
    HOSTNAME=${REPLY:-$HOSTNAME}
    [[ "$HOSTNAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]{0,62}$ ]] || die 'Invalid hostname.'
    ask "Timezone [$TIMEZONE]: "
    TIMEZONE=${REPLY:-$TIMEZONE}
    [[ "$TIMEZONE" != *..* && "$TIMEZONE" != /* ]] || die 'Invalid timezone path.'
    ask "Console keymap [$KEYMAP]: "
    KEYMAP=${REPLY:-$KEYMAP}
    [[ "$KEYMAP" =~ ^[A-Za-z0-9_-]+$ ]] || die 'Invalid keymap.'
    ask "Username [$USERNAME]: "
    USERNAME=${REPLY:-$USERNAME}
    [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ && "$USERNAME" != root && ${#USERNAME} -le 31 ]] || die 'Choose a valid non-root login name.'
    ask 'Optional display/full name (leave blank to omit): '
    DISPLAY_NAME=$REPLY

    if [[ -z "$WIFI_SSID" ]]; then
        ask 'Configure Wi-Fi for the installed system? [Y/n]: '
        input=${REPLY:-Y}
        if [[ "$input" =~ ^[Yy]$ ]]; then
            ask 'Wi-Fi SSID (leave blank to skip): '
            WIFI_SSID=$REPLY
            [[ ${#WIFI_SSID} -le 32 ]] || die 'Wi-Fi SSIDs must be at most 32 bytes.'
            if [[ -n "$WIFI_SSID" ]]; then
                ask_secret "Wi-Fi passphrase for $WIFI_SSID: "
                WIFI_PASSWORD=$REPLY
                [[ ${#WIFI_PASSWORD} -ge 8 && ${#WIFI_PASSWORD} -le 63 ]] || die 'Wi-Fi passphrase must be 8–63 characters.'
            fi
        fi
    fi

    # This is an ext4 fstab option, not a filesystem-formatting requirement.
    ROOT_MOUNT_OPTS=noatime,commit=60
}

main() {
    choose_start_mode
    prepare_live_environment

    if (( PHASE == 0 )); then
        ask_personal_choices
        choose_partitions
    else
        say "Resuming installation at phase $PHASE."
        [[ -b "$PART_ROOT" && -b "$PART_EFI" ]] || die 'A partition saved in the state file no longer exists.'
        [[ -n "$LIBC" && -n "$ARCH" && -n "$REPO" ]] || die 'Saved libc/repository settings are incomplete.'
    fi

    if (( PHASE < 2 )); then
        format_and_mount
    else
        say 'Mounting the saved root and EFI partitions without formatting them again.'
        mount_target
        ROOT_UUID=$(blkid -o value -s UUID "$PART_ROOT")
        [[ -n "$ROOT_UUID" ]] || die 'Could not read the saved root filesystem UUID.'
        if (( PHASE == 2 )); then
            say 'Refreshing /etc/fstab after recovery.'
            ensure_fstab_and_root_uuid
            save_state
        fi
    fi

    if (( PHASE < 3 )); then
        bootstrap_base_system
    fi
    if (( PHASE < 4 )); then
        ensure_saved_wifi_password
        configure_target_system
    else
        say 'Base configuration and account setup are already complete.'
    fi
    if (( PHASE < 5 )); then
        install_personal_files
    else
        say 'Personal files and optional packages are already installed.'
    fi

    say 'Installation stages are complete. Saving the final log.'
    cp -f "$LOG_FILE" "$MNT/home/$USERNAME/void-install.log"
    chroot "$MNT" chown "$USERNAME:users" "/home/$USERNAME/void-install.log"
    PHASE=6
    save_state
    cleanup_mounts
    trap - EXIT ERR INT TERM
    say 'Installation completed.'
    printf '  Disk:          %s\n  Root:          %s\n  EFI mounted:   %s at /boot\n  Swap:          %s\n  Libc:          %s (%s)\n  User:          %s\n  Bootloader:    systemd-boot\n  Kernel:        custom on musl when install succeeds; standard Void kernel retained\n  Services:      dhcpcd, wpa_supplicant, tlp, dbus, elogind\n  Audio:         PipeWire/WirePlumber installed; start-dwl.sh left as in repository\n  Log:           /home/%s/void-install.log\n' \
        "$TARGET_DISK" "$PART_ROOT" "$PART_EFI" "${PART_SWAP:-none}" "$LIBC" "$ARCH" "$USERNAME" "$USERNAME" | tee /dev/tty >/dev/null
    say 'Remove the live media and reboot when ready.'
}

main "$@"
